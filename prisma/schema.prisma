generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                 Int        @id @default(autoincrement())
  correo             String     @unique
  contrasena         String
  nombre             String
  telefono           String?    
  documentoIdentidad String?    @unique 
  rol                String     @default("CLIENTE") 
  fechaRegistro      DateTime   @default(now())
  fechaEdicion       DateTime   @updatedAt
  reservas           Reserva[]
}
model Destino {
  id                 Int        @id @default(autoincrement())
  nombre             String
  descripcion        String?
  pais               String
  ciudad             String     
  imagenUrl          String?    
  cuposDisponibles   Int        
  activo             Boolean    @default(true) 
  precioPorDia       Decimal
  fechaRegistro      DateTime   @default(now())
  fechaEdicion       DateTime   @updatedAt
  reservas           Reserva[]
}

model Reserva {
  id                 Int        @id @default(autoincrement())
  usuarioId          Int
  destinoId          Int
  fechaInicio        DateTime
  fechaFin           DateTime
  numeroPasajeros    Int        @default(1) 
  notasEspeciales    String?    
  precioTotal        Decimal
  estado             String     @default("PENDIENTE") 
  fechaRegistro      DateTime   @default(now())
  fechaEdicion       DateTime   @updatedAt
  usuario            Usuario    @relation(fields: [usuarioId], references: [id])
  destino            Destino    @relation(fields: [destinoId], references: [id])
  pago               Pago?
}

model Pago {
  id                 Int        @id @default(autoincrement())
  reservaId          Int        @unique
  monto              Decimal
  metodo             String     
  moneda             String     @default("USD") 
  codigoTransaccion  String?    @unique 
  estado             String     @default("COMPLETADO") 
  fechaPago          DateTime   @default(now())
  reserva            Reserva    @relation(fields: [reservaId], references: [id])
}